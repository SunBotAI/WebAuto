# WebAuto v3 runtime. Copy to a secret manager or process environment;
# the application does not parse this file automatically.
WEBAUTO_ENV=development
WEBAUTO_RUNTIME_DIR=var
WEBAUTO_DATABASE_URL=
WEBAUTO_REDIS_URL=redis://127.0.0.1:6379/0
WEBAUTO_CHROME_EXECUTABLE=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe
